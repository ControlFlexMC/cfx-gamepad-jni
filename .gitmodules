[submodule "third_party/SDL"]
	path = third_party/SDL
	url = https://github.com/libsdl-org/SDL.git
	# Pin is the gitlink SHA in this repo (not a .gitmodules field):
	#   release-3.4.14 / 147a8ee32dbf9ac02f3794964490687b6bbda1bc
	# `git submodule update` checks out that commit. Do not set `branch`
	# here — that is only used by `git submodule update --remote` and would
	# float the checkout.
